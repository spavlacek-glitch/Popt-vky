{
  "rules": {
    "uzivatele": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "poptavky": {
      ".indexOn": ["prodejce"],
      ".read": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true && (root.child('uzivatele').child(auth.uid).child('vedouci').val() === true || (query.orderByChild === 'prodejce' && query.equalTo === auth.token.email))",
      "$poptavka": {
        ".read": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true && (root.child('uzivatele').child(auth.uid).child('vedouci').val() === true || data.child('prodejce').val() === auth.token.email)",
        ".write": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true && (root.child('uzivatele').child(auth.uid).child('vedouci').val() === true || (!data.exists() && newData.child('prodejce').val() === auth.token.email && !newData.child('dohody').exists()) || (!newData.exists() && data.child('prodejce').val() === auth.token.email))",
        "dohody": {
          "$dohoda": {
            ".write": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true && root.child('poptavky').child($poptavka).child('prodejce').val() === auth.token.email && data.exists() && newData.exists() && newData.child('stav').val() === 'hotovo' && (data.child('stav').val() === 'otevrena' || data.child('stav').val() === 'dopracovat' || data.child('stav').val() === 'hotovo') && newData.child('text').val() === data.child('text').val() && newData.child('do').val() === data.child('do').val() && newData.child('zadal').val() === data.child('zadal').val() && newData.child('t').val() === data.child('t').val()"
          }
        },
        "$pole": {
          ".write": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true && $pole !== 'dohody' && $pole !== 'prodejce' && root.child('poptavky').child($poptavka).child('prodejce').val() === auth.token.email"
        },
        "nabidky": {
          ".write": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true && root.child('poptavky').child($poptavka).child('prodejce').val() === auth.token.email",
          "$nabidka": {
            ".validate": "$nabidka.length <= 64 && root.child('poptavky').child($poptavka).child('stav').exists() && newData.hasChildren(['model', 'cena_sdph', 't', 'kdo'])",
            "model":         { ".validate": "newData.isString() && newData.val().length <= 80" },
            "cena_sdph":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "cena_vuz_sdph": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "sleva_sdph":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "sleva_pct":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "doplnky_sdph":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "soubor":        { ".validate": "newData.isString() && newData.val().length <= 120" },
            "zdroj":         { ".validate": "newData.val() === 'offerstudio'" },
            "t":             { ".validate": "newData.isNumber() && newData.val() <= now" },
            "kdo":           { ".validate": "newData.val() === auth.token.email" },
            "interni": {
              "zisk":           { ".validate": "newData.isNumber()" },
              "skutecny_zisk":  { ".validate": "newData.isNumber()" },
              "obchodni_marze": { ".validate": "newData.isNumber()" },
              "skutecna_marze": { ".validate": "newData.isNumber()" },
              "korekce":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "nestandardni":   { ".validate": "newData.isBoolean()" },
              "negativni":      { ".validate": "newData.isBoolean()" },
              "$jine":          { ".validate": false }
            },
            "$jine": { ".validate": false }
          }
        }
      }
    },

    "zakaznici": {
      ".read": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true",
      "$zakaznik": {
        ".write": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true",
        ".validate": "$zakaznik.length <= 80 && newData.hasChildren(['zdroj', 'vytvoreno', 'upraveno', 'upravil']) && (newData.hasChild('jmeno') || newData.hasChild('prijmeni') || newData.hasChild('firma'))",

        "jmeno":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
        "prijmeni": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
        "firma":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 150" },
        "ico":      { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4,12}$/)" },
        "telefon":  { ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().matches(/^[0-9 +()\\/-]+$/)" },
        "email":    { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^@ ]+@[^@ ]+\\.[^@ ]+$/)" },
        "zdroj":    { ".validate": "newData.val() === 'dfe' || newData.val() === 'poptavka'" },
        "vytvoreno":{ ".validate": "newData.isNumber() && newData.val() <= now" },
        "upraveno": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "upravil":  { ".validate": "newData.val() === auth.uid" },

        "klice": {
          ".validate": "newData.hasChildren()",
          "$klic": { ".validate": "$klic.matches(/^(ph|em|id):.{1,100}$/) && newData.val() === true" }
        },

        "vozidla": {
          ".validate": "newData.hasChildren()",
          "$vozidlo": {
            ".validate": "$vozidlo.length <= 80 && (newData.hasChild('model') || newData.hasChild('trida') || newData.hasChild('vin'))",
            "model":   { ".validate": "newData.isString() && newData.val().length <= 80" },
            "trida":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "vin":     { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{5,17}$/)" },
            "auftrag": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "predano": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "$jine":   { ".validate": false }
          }
        },

        "$jine": { ".validate": false }
      }
    }
  }
}
