{
  "rules": {
    "uzivatele": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "poptavky": {
      ".read": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true",
      ".write": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true"
    },

    "zakaznici": {
      ".read": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true",
      "$zakaznik": {
        ".write": "auth != null && root.child('uzivatele').child(auth.uid).child('schvalen').val() === true",
        ".validate": "$zakaznik.length <= 80 && newData.hasChildren(['zdroj', 'vytvoreno', 'upraveno', 'upravil']) && (newData.hasChild('jmeno') || newData.hasChild('prijmeni') || newData.hasChild('firma'))",

        "jmeno":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
        "prijmeni": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
        "firma":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 150" },
        "ico":      { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4,12}$/)" },
        "telefon":  { ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().matches(/^[0-9 +()\\/-]+$/)" },
        "email":    { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^@ ]+@[^@ ]+\\.[^@ ]+$/)" },
        "zdroj":    { ".validate": "newData.val() === 'dfe' || newData.val() === 'poptavka'" },
        "vytvoreno":{ ".validate": "newData.isNumber() && newData.val() <= now" },
        "upraveno": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "upravil":  { ".validate": "newData.val() === auth.uid" },

        "klice": {
          ".validate": "newData.hasChildren()",
          "$klic": { ".validate": "$klic.matches(/^(ph|em|id):.{1,100}$/) && newData.val() === true" }
        },

        "vozidla": {
          ".validate": "newData.hasChildren()",
          "$vozidlo": {
            ".validate": "$vozidlo.length <= 80 && (newData.hasChild('model') || newData.hasChild('trida') || newData.hasChild('vin'))",
            "model":   { ".validate": "newData.isString() && newData.val().length <= 80" },
            "trida":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "vin":     { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{5,17}$/)" },
            "auftrag": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "predano": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "$jine":   { ".validate": false }
          }
        },

        "$jine": { ".validate": false }
      }
    }
  }
}
